
GOOGLE_API_KEY=

DB_URL=jdbc:postgresql://localhost:5432/ai_chat
DB_USER=
DB_PASSWORD=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

SERVER_PORT=8080

GEMINI_MODEL=
GEMINI_TIMEOUT_MS=30000

# gemini (default) or fake — see FakeLlmProvider; used to load-test the queue pipeline without
# real LLM latency/cost.
LLM_PROVIDER=gemini
FAKE_LLM_CHUNK_DELAY_MS=20

CONVERSATION_CACHE_ENABLED=true

# ADR-007: HMAC signing key for issued JWTs — generate with e.g. `openssl rand -base64 64`.
# Access-token-only (no refresh); expiry controls how often clients must re-login.
JWT_SECRET=
JWT_EXPIRATION_MS=3600000