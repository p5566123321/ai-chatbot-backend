
GOOGLE_API_KEY=

DB_URL=jdbc:postgresql://localhost:5432/ai_chat
DB_USER=
DB_PASSWORD=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

SERVER_PORT=8080

# DocumentController upload/replace — Spring Boot's own multipart defaults are 1MB/10MB.
DOCUMENT_MAX_FILE_SIZE=100MB
DOCUMENT_MAX_REQUEST_SIZE=100MB

GEMINI_MODEL=
GEMINI_TIMEOUT_MS=30000
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_TIMEOUT_MS=3000
# Must match document_chunk.embedding's vector(N) column (V2__enable_pgvector.sql) — changing this
# without a matching migration breaks inserts.
GEMINI_EMBEDDING_DIMENSIONS=768

# gemini is the only EmbeddingProvider today; kept as its own var (mirrors LLM_PROVIDER) so a
# fake/alternate provider slots in later without touching this shape.
EMBEDDING_PROVIDER=gemini

# RecursiveCharacterTextSplitter (RAG ingestion) — chars, not tokens.
RAG_SPLITTER_CHUNK_SIZE=800
RAG_SPLITTER_CHUNK_OVERLAP=100

# RagService retrieval tuning — how many candidate chunks pgvector returns (top-k) and the
# minimum cosine similarity score (range [-1, 1]) a chunk must clear to reach the prompt.
RAG_SEARCH_TOP_K=5
RAG_SEARCH_SIMILARITY_THRESHOLD=0.0

# gemini (default) or fake — see FakeLlmProvider; used to load-test the queue pipeline without
# real LLM latency/cost.
LLM_PROVIDER=gemini
FAKE_LLM_CHUNK_DELAY_MS=20

CONVERSATION_CACHE_ENABLED=true

# ADR-007: HMAC signing key for issued JWTs — generate with e.g. `openssl rand -base64 64`.
# Access-token-only (no refresh); expiry controls how often clients must re-login.
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# docs/decision/010: AES-256 key encrypting user-supplied Gemini API keys at rest (BYOK) —
# generate with `openssl rand -base64 32`. Must decode to exactly 32 bytes or the app fails to
# start (ApiKeyCipher).
BYOK_ENCRYPTION_KEY=